# Tokens: {label} {path}
[cwd]
format = {tpah}
style  = abbrev          # abbrev (~ for $HOME) | full | basename
fg     = bright_blue

# ── git ────────────────────────────────────────────────────────────────
# Tokens: {label} {branch} — branch name, or an 8-hex short SHA when
# detached. The section ��nishes outside a repository.
[git]
format = {branch}
fg     = bright_green

# ── model ─────────────────────℀──────────────────────────────�bel}"Fable 5 5".
[model]
format = {name} {ver} ·{effort}
fg     = bright_magenta
effort_fg = bright_black

# ── context ─────────────────────────────�—�─────�t} uses Claude Code's precomputed figure when present, else derives
# it from used/ceiling. Perto show also swallows the literal run before it, so
# "{name} {ver} ·{effort}" degrades to "Fable 5" — never "Fable 5 ·".
# {{ and }} give literal braces. Every section also has a {label} token,
# filled from its `label` key.

[statusline]
# Any subset, any order. A section with nothing to show vanishes,
# separator included.
sections  = cwd git model context plan_short plan_long
separator = " │ "
separator_fg = bright_black
# Digit grouping for token counts. �─────────────────────────────────
# Tokens: {label} {name} {ver} {effn_short]
format = {window} {pct}
fg     = bright_black
pct_fg = bright_yellow

