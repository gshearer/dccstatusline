# dccstatusline — reference configuration
#
# This file documents the compiled-in defaults: with no config file present,
# exactly this is what you get, and the binary prints it with --print-config.
# To customize, put a copy in place and edit it:
#
#     mkdir -p ~/.config/dccstatusline
#     dccstatusline --print-config > ~/.config/dccstatusline/config
#
# Every key is optional; unknown keys and sections are ignored, and a value
# that fails to parse keeps its default (with a note on stderr, visible via
# `claude --debug`). The DCCSTATUSLINE_CONFIG environment variable overrides
# the config path entirely.
#
# Colors, wherever a *_fg or *_bg key appears:
#     names      black red green yellow blue magenta cyan white,
#                each also with a bright_ prefix (e.g. bright_cyan)
#     256-color  a number 0-255
#     truecolor  #rrggbb
#     default    clears a compiled-in color
#
# Values with significant whitespace belong in quotes: separator = " | ".
# Inside quotes, \" is a literal quote and \\ a literal backslash. After an
# unquoted value a comment starts at a # preceded by whitespace — a leading
# # is data, which is why truecolor values need no quoting.
#
# Formats are templates. {tokens} are replaced by live values and styled by
# their *_fg/*_bg keys; literal text is styled by the section's fg/bg. A
# token with nothing to show also swallows the literal run before it, so
# "{name} {ver} · {effort}" degrades to "Fable 5" — never "Fable 5 ·".
# {{ and }} give literal braces. Every section also has a {label} token,
# filled from its `label` key.

[statusline]
# A preset restyling colors only: catppuccin nord gruvbox tokyonight
# dracula onedark rosepine kanagawa solarized. Unset by default: with no
# theme, or `theme = none`, the line wears the colors below, the terminal's
# own 16.
# `dccstatusline --themes` shows each one. The theme lands
# where this line sits, so every key after it wins over the theme — keep
# it first, and in a copy of this file delete the keys below that you
# didn't change yourself, or they will paint over the theme.
# theme = nord
# duotone | tritone | monochrome, duotone by default: how many of the
# theme's three colors the line wears beside its muted one. Duotone puts
# the first on the cwd and branch and the second on the model and the
# figures, tritone gives the figures a third of their own, and monochrome
# paints all of it in the first. It lays the theme again where this line
# sits, so keep it right after `theme`. It takes a theme: with none, the
# colors below stay as they are under any palette.
# palette = tritone
# basic | detailed, unset by default. A profile is a whole line decided for
# you: it replaces `sections` and every `format` below, wherever they sit,
# and leaves the colors and everything else to this file. Both draw all six
# sections; basic trims them to the figures, detailed adds the token
# counts and the reset times:
#   basic
#     ~/src/acme │ main │ Opus 5.5 · high │ ctx 43% │ 5h 24% │ 7d 41%
#   detailed, the same up to the model, then
#     ctx 87,333/200,000 43% │ 5h 24% 02:30 │ 7d 41% 03:12:00
# Neither draws a glyph until `glyphs = on`: ⎇ before the branch, and
# under detailed ↻ before the reset times. `glyphs = nerdfont` draws U+E0A0
# and U+F021 in their place, draws the model as a filled pill between the
# rounded caps U+E0B6 and U+E0B4, and drops the dot before the effort.
# Those take a Nerd Font and are empty boxes without one. Without a
# profile the glyphs key does nothing, since the glyphs are the formats'
# own. On the command line, `--theme <name>`, `--palette <palette>`,
# `--profile <name>` and `--glyphs on|off|nerdfont` stand in for these four
# keys:
# dccstatusline --theme nord --palette tritone --profile basic --glyphs on
# profile = basic
# glyphs = on
# Any subset, any order. A section with nothing to show vanishes,
# separator included.
sections  = cwd git model context plan_short plan_long
separator = " │ "
separator_fg = bright_black
# Digit grouping for token counts. "" disables.
thousands = ,

# ── cwd ────────────────────────────────────────────────────────────────
# Tokens: {label} {path}
#
# Three stages, each off by default: `style` picks the base form, `depth`
# says how many trailing components stay whole, and `max_len` is a hard
# budget in characters. Whatever is elided becomes a single "…". With $HOME
# at /home/u and a repository rooted at /home/u/src/acme:
#
#   style = abbrev    ~ for an exact $HOME prefix      ~/src/acme/proj
#   style = full      exactly what Claude Code sent    /home/u/src/acme/proj
#   style = basename  the last component alone         proj
#   style = shrink    abbrev, then one letter apiece   ~/s/a/proj
#                     (dot-directories keep the dot: ~/.config → ~/.c)
#   style = repo      from the repository's name down  acme/proj
#
#   depth = 2         …/acme/proj — with style = shrink, the last two
#                     components stay whole instead: ~/s/acme/proj
#   max_len = 8       …/proj — leading components go first, then the last
#                     one is cut; CJK and emoji render two columns wide
[cwd]
format  = {path}
style   = abbrev         # abbrev | full | basename | shrink | repo
depth   = 0              # trailing components kept whole; 0 = off
max_len = 0              # character budget for the rendered path; 0 = off
fg      = bright_blue

# ── git ────────────────────────────────────────────────────────────────
# Tokens: {label} {branch} — branch name, or an 8-hex short SHA when
# detached. The section vanishes outside a repository.
[git]
format = {branch}
fg     = bright_green

# ── model ──────────────────────────────────────────────────────────────
# Tokens: {label} {name} {ver} {effort} {effort_plain} {model_tag} {id}
# {ver} is derived from the model id (claude-fable-5 → "5") and goes empty
# when {name} already ends with it — "Fable 5", never "Fable 5 5".
# {model_tag} is {name} {ver} as one filled pill, with rounded caps that
# need a Nerd Font. It fills with model_tag_bg, or with the section's fg
# while that is unset, so recoloring the model recolors the pill.
# {effort_plain} is {effort} with no color of its own, so it takes the
# section's fg.
[model]
format = {name} {ver} · {effort}
fg     = bright_magenta
effort_fg = bright_black
model_tag_fg = black

# ── context ────────────────────────────────────────────────────────────
# Tokens: {label} {used} {ceiling} {pct}
# {pct} uses Claude Code's precomputed figure when present, else derives
# it from used/ceiling. Percent signs are part of the token.
[context]
format  = {label} {used}/{ceiling} {pct}
label   = ctx
fg      = bright_black
used_fg = cyan
pct_fg  = bright_cyan

# ── plan usage ─────────────────────────────────────────────────────────
# Claude Code reports a short and a long rate-limit window (5-hour and
# 7-day today). {window} renders the current tag ("5h"/"7d"), so these
# sections survive any future window change without config edits.
# Tokens: {label} {window} {pct} {resets}
#
# The `resets` key picks what {resets} says:
#     countdown  time left — "04:12" (HH:MM), "03:19:47" (DD:HH:MM) in
#                the long window
#     clock      the local reset time, 24-hour — "19:20", "Mon 19:20"
#     clock12    the same in 12-hour — "7:20 PM", "Mon 7:20 PM"
# The long window carries the weekday and the day count: one bare time
# cannot say which of seven days it means. A window that reports no reset
# renders nothing at all, ↻ included.
[plan_short]
format = {window} {pct} ↻{resets}
resets = countdown
fg     = bright_black
pct_fg = bright_yellow

[plan_long]
format = {window} {pct} ↻{resets}
resets = countdown
fg     = bright_black
pct_fg = yellow
